---
import Logo from './Logo.astro';
import { sections, pages, social, isActive } from './nav';

const currentPath = Astro.url.pathname;
---

<aside class="sidebar hidden lg:flex sticky top-0 h-screen flex-col justify-between border-r border-rule px-8 py-10">
  <div>
    <div class="mb-12">
      <Logo class="h-7 w-7" />
    </div>

    <nav>
      <ul class="flex flex-col gap-1.5 list-none p-0">
        {sections.map((item) => (
          <li>
            <a
              href={item.href}
              class="sidebar-link block py-1 text-sm text-fg-tertiary no-underline transition-colors duration-150 hover:text-accent-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="my-4 h-px w-8 bg-rule"></div>

      <ul class="flex flex-col gap-1.5 list-none p-0">
        {pages.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
              class:list={[
                "block py-1 text-sm no-underline transition-colors duration-150 hover:text-accent-ink",
                isActive(currentPath, item.href) ? "text-fg" : "text-fg-tertiary",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div>
    <a
      href={social.href}
      class="font-mono text-xs text-fg-tertiary no-underline transition-colors duration-150 hover:text-accent-ink"
      target="_blank"
      rel="noopener"
    >
      {social.label}
    </a>
  </div>
</aside>

---
interface Props {
  /** Tailwind size classes for the rounded plate. */
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<a href="/" class="flex items-center gap-2.5 no-underline" aria-label="Bird Candy — home">
  <div class:list={['flex items-center justify-center rounded-md bg-fg shrink-0', className]}>
    <svg class="h-[70%] w-[70%] text-bg" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill="currentColor" d="M64 20 24 56 104 56Z"></path>
      <rect fill="currentColor" x="38" y="53" width="52" height="53" rx="4"></rect>
      <circle cx="64" cy="73" r="12" fill="var(--color-accent)"></circle>
      <rect x="55" y="88" width="18" height="5" rx="2.5" fill="var(--color-accent-blue)"></rect>
    </svg>
  </div>
  <span class="text-[15px] font-medium tracking-tight">Bird Candy</span>
</a>

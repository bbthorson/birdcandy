---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/layout/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Matches SHOW_DRAFTS in the index; drafts stay reachable by direct URL either way.
const SHOW_DRAFTS = true;

const siblings = (await getCollection('writing'))
  .filter((p) => p.id !== post.id && (SHOW_DRAFTS || !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<BaseLayout
  title={`${post.data.title} — Bird Candy`}
  description={post.data.dek}
  noindex={post.data.draft}
>
  <article class="pt-20 pb-16 lg:pt-30">
    <!-- HEADER -->
    <header class="mb-14">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8">
        <a
          href="/writing/"
          class="font-mono text-[11px] uppercase tracking-widest text-fg-tertiary no-underline transition-colors duration-150 hover:text-accent-ink"
        >
          Writing
        </a>
        <span class="font-mono text-[11px] uppercase tracking-widest text-accent-blue">
          For {post.data.audience}
        </span>
        {post.data.draft && (
          <span class="font-mono text-[10px] uppercase tracking-widest text-accent-ink border border-accent/40 rounded-full px-2 py-0.5">
            Draft
          </span>
        )}
      </div>

      <h1 class="text-3xl lg:text-5xl font-medium leading-[1.08] tracking-tighter max-w-[680px] mb-8">
        {post.data.title}
      </h1>
      <p class="text-[17px] leading-relaxed text-fg-secondary max-w-[540px]">
        {post.data.dek}
      </p>
      <p class="font-mono text-[11px] text-fg-tertiary mt-8">{fmt}</p>
    </header>

    <!-- BODY -->
    <div class="prose border-t border-rule pt-12">
      <Content />
    </div>
  </article>

  <!-- MORE -->
  {siblings.length > 0 && (
    <section class="fade-in pt-6 pb-20">
      <hr class="border-t border-rule mb-10" />
      <p class="font-mono text-[11px] uppercase tracking-widest text-fg-tertiary mb-8">
        The other vantage points
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-[760px]">
        {siblings.map((p) => (
          <a
            href={`/writing/${p.id}/`}
            class="group block border border-rule p-6 no-underline transition-colors duration-150 hover:border-fg"
          >
            <p class="font-mono text-[11px] uppercase tracking-widest text-accent-blue mb-3">
              For {p.data.audience}
            </p>
            <p class="text-[17px] font-medium tracking-tight leading-snug mb-2">{p.data.title}</p>
            <p class="text-[13px] leading-relaxed text-fg-tertiary">{p.data.dek}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>
